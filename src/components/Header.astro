            <li><a href={routes.disinsection.ticks} class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-accent-primary)] transition-colors block p-1">{t('srv.ticks')}</a></li>
            <li><a href={routes.disinsection.ants} class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-accent-primary)] transition-colors block p-1">{t('srv.ants')}</a></li>
            <li><a href={routes.disinsection.wasps} class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-accent-primary)] transition-colors block p-1">{t('srv.wasps')}</a></li>
            <li><a href={routes.disinsection.moths} class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-accent-primary)] transition-colors block p-1">{t('srv.moths')}</a></li>
