    <!-- Navigation -->
    <nav class="hidden lg:flex items-center gap-2 xl:gap-4 2xl:gap-6 text-sm font-medium text-[var(--color-text-main)] whitespace-nowrap">
      <a href={routes.home} class="hover:text-[var(--color-accent-primary)] transition-colors">{t('nav.home')}</a>
      <a href={routes.about} class="hover:text-[var(--color-accent-primary)] transition-colors">{t('nav.about')}</a>
      
