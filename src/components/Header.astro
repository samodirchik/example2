---
import Button from './Button.astro';
import { useTranslations } from '../i18n/ui';
import { routes } from '../i18n/routes';

interface Props {
  lang?: 'ru' | 'ua' | 'en';
}
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

const currentPath = Astro.url.pathname;
const normalizedPath = currentPath.endsWith('/') && currentPath.length > 1 ? currentPath.slice(0, -1) : currentPath;

const routeMap: Record<string, string> = {
  '/': '/ru',
  '/o-nac': '/o-nac-ru',
  '/prodazh-khimii-ua': '/prodazha-himii-ru',
  '/kontakty-ua': '/kontakty-ru',
  '/dezinsekciya-ua/klopy-ua': '/dezinsekciya-ru/klopy-ru',
  '/dezinsekciya-ua/tarakany-ua': '/dezinsekciya-ru/tarakany-ru',
  '/dezinsekciya-ua/blohi-ua': '/dezinsekciya-ru/blohi-ru',
  '/dezinsekciya-ua/kleshchi-ua': '/dezinsekciya-ru/kleshchi-ru',
  '/dezinsekciya-ua/murahy-ua': '/dezinsekciya-ru/muravi-ru',
  '/dezinsekciya-ua/osy-ua': '/dezinsekciya-ru/osy-ru',
  '/dezinsekciya-ua/mil-ua': '/dezinsekciya-ru/mol-ru',
  '/dezinsekciya-ua/koroidy-ua': '/dezinsekciya-ru/koroedy-ru',
  '/dezinsekciya-ua/sinoidy-ua': '/dezinsekciya-ru/senoedy-ru',
  '/dezinsekciya-ua/shershni-ua': '/dezinsekciya-ru/shershni-ru',
  '/dezinsekciya-ua/pavuky-ua': '/dezinsekciya-ru/pauki-ru',
  '/dezinsekciya-ua/komari-ua': '/dezinsekciya-ru/komary-ru',
  '/dezinsekciya-ua/muhy-ua': '/dezinsekciya-ru/muhi-ru',
  '/dezinsekciya-ua/mokryci-ua': '/dezinsekciya-ru/mokricy-i-cheshujnicy-ru',
  '/dezinsekciya-ua/shkiroidy-ua': '/dezinsekciya-ru/kozheedy-ru',
  '/dezinsekciya-ua/hlibni-tochilnyky-ua': '/dezinsekciya-ru/hlebnye-tochilshiki-ru',
  '/dezinsekciya-ua/moshky-ua': '/dezinsekciya-ru/moshki-ru',
  '/dezinsekciya-ua/termity-ua': '/dezinsekciya-ru/termity-ru',
  '/dezinsekciya-ua/skolopendry-ua': '/dezinsekciya-ru/skolopendry-ru',
  '/dezinsekciya-ua/slyzni-ua': '/dezinsekciya-ru/slizni-ru',
  '/deratyzaciya-ua/shchury-ta-myshi-ua': '/deratizaciya-ru/krysy-i-myshi-ru',
  '/dezinfekciya-ua/virusy-i-bakterii-ua': '/dezinfekciya-ru/virusy-i-bakterii-ru',
  '/dezinfekciya-ua/koronavirus-ua': '/dezinfekciya-ru/koronavirus-ru',
  '/dezinfekciya-ua/plesen-i-gribok-ua': '/dezinfekciya-ru/plesen-i-gribok-ru',
  '/dezinfekciya-ua/gorysha-ta-pidvaly-ua': '/dezinfekciya-ru/cherdaki-i-podvaly-ru'
};

let ruLink = '/ru';
let uaLink = '/';

if (lang === 'ua') {
  ruLink = routeMap[normalizedPath] || '/ru';
  uaLink = normalizedPath;
} else {
  const foundUa = Object.keys(routeMap).find(key => routeMap[key] === normalizedPath);
  uaLink = foundUa || '/';
  ruLink = normalizedPath;
}
---

<header class="fixed top-0 w-full z-50 p-2 sm:p-4 lg:p-6 pointer-events-none">
  <div class="max-w-[1600px] mx-auto flex justify-between items-center glass-panel px-3 sm:px-6 py-3 sm:py-4 rounded-2xl sm:rounded-3xl shadow-lg relative pointer-events-auto">
    
    <!-- Logo & Subtitle -->
    <div class="flex flex-col flex-shrink-0 mr-2 sm:mr-4">
      <a href={routes.home} class="text-lg sm:text-2xl font-bold tracking-tighter hover:text-[var(--color-accent-primary)] transition-colors" style="font-family: var(--font-heading)">CUCARACHA</a>
      <div class="text-[9px] uppercase tracking-wider text-[var(--color-text-muted)] max-w-[200px] leading-tight mt-1 hidden xl:block">
        {t('header.subtitle')}
      </div>
    </div>

    <!-- Navigation -->
    <nav class="hidden lg:flex items-center gap-2 xl:gap-4 2xl:gap-6 text-sm font-medium text-[var(--color-text-main)] whitespace-nowrap">
