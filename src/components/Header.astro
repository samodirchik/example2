          <a href={routes.disinfection.corona} class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-accent-primary)] p-1">{t('srv.corona')}</a>
          <a href={routes.disinfection.mold} class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-accent-primary)] p-1">{t('srv.mold')}</a>
