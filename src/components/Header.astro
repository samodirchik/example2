      <div class="flex flex-col items-end">
        <a href="tel:+18005550199" class="text-sm font-bold text-[var(--color-text-main)] hover:text-[var(--color-accent-primary)] transition-colors leading-tight">+1 (800) 555-0199</a>
        <span class="text-[10px] text-[var(--color-text-muted)] font-medium mt-0.5 uppercase tracking-wide">{t('header.247')}</span>
      </div>

      <div class="hidden 2xl:block">
        <Button text={t('nav.call')} href="#consultation-form" variant="primary" class="ml-2 px-6 py-3 text-xs shadow-md" />
      </div>
    </div>

    <!-- Mobile Contacts & Menu Button -->
    <div class="lg:hidden flex items-center justify-end pointer-events-auto gap-2 sm:gap-4 flex-shrink-0">
      <!-- Mobile Contacts -->
      <div class="flex flex-col items-end justify-center">
        <a href="tel:+18005550199" class="text-[11px] sm:text-xs font-bold text-[var(--color-text-main)] hover:text-[var(--color-accent-primary)] leading-tight whitespace-nowrap">+1 (800) 555-0199</a>
      </div>
      <!-- Mobile menu button -->
      <button aria-label="Menu" id="mobile-menu-btn" class="p-1 sm:p-2 text-[var(--color-text-main)] pointer-events-auto">
        <svg class="w-7 h-7 sm:w-8 sm:h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
