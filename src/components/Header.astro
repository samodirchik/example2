          <ul class="flex flex-col gap-2">
            <li><a href={routes.disinsection.bugs} class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-accent-primary)] transition-colors block p-1">{t('srv.bugs')}</a></li>
