        <div class="absolute top-full left-0 mt-2 w-56 bg-white/95 backdrop-blur-2xl border border-white/50 rounded-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 transform translate-y-2 group-hover:translate-y-0 shadow-2xl p-4 flex flex-col gap-2">
