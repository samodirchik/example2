          <button aria-label="Toggle Dropdown" class="p-2 dropdown-toggle text-gray-400 hover:text-[var(--color-accent-primary)] transition-transform duration-300">
            <svg class="w-5 h-5 dropdown-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </button>
        </div>
        <div class="dropdown-content hidden flex-col pl-4 mt-2 space-y-3 pb-2 border-l-2 border-gray-100 ml-2">
          <a href={routes.deratization.rats_mice} class="text-[17px] text-[var(--color-text-muted)] hover:text-[var(--color-accent-primary)] mobile-link block">{t('srv.rats_mice')}</a>
        </div>
      </div>

      <div class="mobile-dropdown">
        <div class="w-full flex items-center justify-between py-2 group border-b border-[rgba(0,0,0,0.05)]">
          <span class="text-xl font-bold text-left text-[var(--color-text-main)] flex-grow">
            {t('nav.disinfection')}
          </span>
          <button aria-label="Toggle Dropdown" class="p-2 dropdown-toggle text-gray-400 hover:text-[var(--color-accent-primary)] transition-transform duration-300">
