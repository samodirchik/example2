          <a href={routes.disinsection.bark_beetles} class="text-[17px] text-[var(--color-text-muted)] hover:text-[var(--color-accent-primary)] mobile-link block">{t('srv.bark_beetles')}</a>
          <a href={routes.disinsection.booklice} class="text-[17px] text-[var(--color-text-muted)] hover:text-[var(--color-accent-primary)] mobile-link block">{t('srv.booklice')}</a>
          <a href={routes.disinsection.hornets} class="text-[17px] text-[var(--color-text-muted)] hover:text-[var(--color-accent-primary)] mobile-link block">{t('srv.hornets')}</a>
          <a href={routes.disinsection.spiders} class="text-[17px] text-[var(--color-text-muted)] hover:text-[var(--color-accent-primary)] mobile-link block">{t('srv.spiders')}</a>
          <a href={routes.disinsection.mosquitoes} class="text-[17px] text-[var(--color-text-muted)] hover:text-[var(--color-accent-primary)] mobile-link block">{t('srv.mosquitoes')}</a>
          <a href={routes.disinsection.flies} class="text-[17px] text-[var(--color-text-muted)] hover:text-[var(--color-accent-primary)] mobile-link block">{t('srv.flies')}</a>
          <a href={routes.disinsection.woodlice} class="text-[17px] text-[var(--color-text-muted)] hover:text-[var(--color-accent-primary)] mobile-link block">{t('srv.woodlice')}</a>
          <a href={routes.disinsection.carpet_beetles} class="text-[17px] text-[var(--color-text-muted)] hover:text-[var(--color-accent-primary)] mobile-link block">{t('srv.carpet_beetles')}</a>
          <a href={routes.disinsection.biscuit_beetles} class="text-[17px] text-[var(--color-text-muted)] hover:text-[var(--color-accent-primary)] mobile-link block">{t('srv.biscuit_beetles')}</a>
          <a href={routes.disinsection.midges} class="text-[17px] text-[var(--color-text-muted)] hover:text-[var(--color-accent-primary)] mobile-link block">{t('srv.midges')}</a>
          <a href={routes.disinsection.termites} class="text-[17px] text-[var(--color-text-muted)] hover:text-[var(--color-accent-primary)] mobile-link block">{t('srv.termites')}</a>
          <a href={routes.disinsection.centipedes} class="text-[17px] text-[var(--color-text-muted)] hover:text-[var(--color-accent-primary)] mobile-link block">{t('srv.centipedes')}</a>
          <a href={routes.disinsection.slugs} class="text-[17px] text-[var(--color-text-muted)] hover:text-[var(--color-accent-primary)] mobile-link block">{t('srv.slugs')}</a>
        </div>
      </div>

      <div class="mobile-dropdown">
        <div class="w-full flex items-center justify-between py-2 group border-b border-[rgba(0,0,0,0.05)]">
          <span class="text-xl font-bold text-left text-[var(--color-text-main)] flex-grow">
