---
import Button from './Button.astro';
import { useTranslations } from '../i18n/ui';
import { routes } from '../i18n/routes';

interface Props {
  lang?: string;
}
const { lang = 'en' } = Astro.props;
const t = useTranslations('en');
---

<header class="fixed top-0 w-full z-50 p-2 sm:p-4 lg:p-6 pointer-events-none">
  <div class="max-w-[1600px] mx-auto flex justify-between items-center glass-panel px-3 sm:px-6 py-3 sm:py-4 rounded-2xl sm:rounded-3xl shadow-lg relative pointer-events-auto">
    
    <!-- Logo & Subtitle -->
    <div class="flex flex-col flex-shrink-0 mr-2 sm:mr-4">
      <a href={routes.home} class="text-lg sm:text-2xl font-bold tracking-tighter hover:text-[var(--color-accent-primary)] transition-colors" style="font-family: var(--font-heading)">CUCARACHA</a>
      <div class="text-[9px] uppercase tracking-wider text-[var(--color-text-muted)] max-w-[200px] leading-tight mt-1 hidden xl:block">
