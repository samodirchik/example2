          <a href={routes.disinfection.viruses} class="text-[17px] text-[var(--color-text-muted)] hover:text-[var(--color-accent-primary)] mobile-link block">{t('srv.viruses')}</a>
          <a href={routes.disinfection.corona} class="text-[17px] text-[var(--color-text-muted)] hover:text-[var(--color-accent-primary)] mobile-link block">{t('srv.corona')}</a>
          <a href={routes.disinfection.mold} class="text-[17px] text-[var(--color-text-muted)] hover:text-[var(--color-accent-primary)] mobile-link block">{t('srv.mold')}</a>
