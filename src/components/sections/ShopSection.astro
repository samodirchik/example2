---
import { shopData } from '../../i18n/data_extended';

interface Props {
  lang?: 'ru' | 'ua';
}
const { lang = 'en' } = Astro.props;
const data = shopData.en;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section class="relative py-24 px-6 z-10">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16 animate-fade-in-up">
      <h2 class="text-4xl md:text-5xl font-bold mb-4 text-[var(--color-text-main)]" style="font-family: var(--font-heading)">
        {data.title}
      </h2>
      <div class="w-24 h-1 bg-[var(--color-accent-primary)] mx-auto rounded-full"></div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 md:gap-6">
      {data.items.map((item, index) => {
        const imgSrc = `${base}${item.img.startsWith('/') ? '' : '/'}${item.img}`;
        return (
          <a href="#consultation-form" class="glass-panel p-6 rounded-3xl flex flex-col items-center justify-center gap-4 hover-spring group cursor-pointer border border-transparent hover:border-[rgba(255,255,255,0.4)] shadow-md hover:shadow-xl transition-all duration-300 animate-fade-in-up" style={`animation-delay: ${index * 0.1}s`}>
            <div class="w-16 h-16 rounded-2xl bg-[var(--color-accent-primary)]/10 flex items-center justify-center mb-2 border border-white/50 shadow-inner group-hover:scale-110 transition-transform duration-300 relative mx-auto">
              <div class="absolute inset-0 bg-[var(--color-accent-primary)] rounded-full blur-xl opacity-0 group-hover:opacity-30 transition-opacity duration-300"></div>
              <img 
                src={imgSrc} 
                alt={item.title} 
                width="40" 
                height="40" 
                loading="lazy" 
                decoding="async" 
                class="w-10 h-10 object-contain relative z-10 drop-shadow-sm group-hover:scale-110 transition-transform duration-300" 
              />
            </div>
            <div class="text-center">
              <h3 class="text-lg font-bold text-[var(--color-text-main)] leading-tight" style="font-family: var(--font-heading)">{item.title}</h3>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>
