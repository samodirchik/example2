---
import { certificatesData } from '../../i18n/data_extended';

interface Props {
  lang?: 'ru' | 'ua';
}
const { lang = 'ua' } = Astro.props;
const data = certificatesData[lang];
---
<section class="relative py-24 px-6 z-10">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16 animate-fade-in-up">
      <h2 class="text-4xl md:text-5xl font-bold mb-4 text-[var(--color-text-main)]" style="font-family: var(--font-heading)">
        {data.title}
      </h2>
      <div class="w-24 h-1 bg-[var(--color-accent-primary)] mx-auto rounded-full"></div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      
      {[1, 2, 3, 4].map((num) => (
        <div class="glass-panel p-2 rounded-2xl hover-spring cursor-pointer group">
          <div class="overflow-hidden rounded-xl border border-[rgba(255,255,255,0.4)]">
            <img src={`/images/texnology-item${num}.jpg`} alt={`Certificate ${num}`} width="984" height="1600" loading="lazy" decoding="async" class="w-full h-auto object-cover transform group-hover:scale-110 transition-transform duration-500" />
          </div>
        </div>
      ))}

    </div>
  </div>
</section>
