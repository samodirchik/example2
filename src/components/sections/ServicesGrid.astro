---
import { servicesData } from '../../i18n/data';

interface Props {
  lang?: 'ru' | 'ua';
}
const { lang = 'en' } = Astro.props;
const data = servicesData.en;
---
<section class="relative py-24 px-6 z-10">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 md:gap-6">
      
      {data.map((item, index) => (
        <a href="#consultation-form" class="glass-panel p-6 rounded-3xl flex flex-col items-center justify-center gap-4 hover-spring group cursor-pointer border border-transparent hover:border-[rgba(255,255,255,0.4)] shadow-md hover:shadow-xl transition-all duration-300 animate-fade-in-up" style={`animation-delay: ${index * 0.1}s`}>
          <div class="w-20 h-20 rounded-full bg-white/10 flex items-center justify-center group-hover:scale-110 transition-transform duration-300 relative">
            <div class="absolute inset-0 bg-blue-400 rounded-full blur-xl opacity-0 group-hover:opacity-30 transition-opacity duration-300"></div>
            <img src={`/images/${item.img}`} alt={item.text2} width="48" height="48" loading="lazy" decoding="async" class="w-12 h-12 object-contain relative z-10 drop-shadow-lg" />
          </div>
          <div class="text-center">
            <div class="text-[10px] uppercase tracking-wider text-[var(--color-text-muted)] font-bold mb-1">{item.text1}</div>
            <h3 class="text-lg font-bold text-[var(--color-text-main)] leading-tight" style="font-family: var(--font-heading)">{item.text2}</h3>
          </div>
        </a>
      ))}
      
    </div>
  </div>
</section>
