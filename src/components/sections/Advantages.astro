---
import { advantagesData } from '../../i18n/data_extended';

interface Props {
  lang?: 'ru' | 'ua';
}
const { lang = 'ua' } = Astro.props;
const data = advantagesData[lang];
---
<section class="relative py-24 px-6 z-10">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16 animate-fade-in-up">
      <h2 class="text-4xl md:text-5xl font-bold mb-4 text-[var(--color-text-main)]" style="font-family: var(--font-heading)">
        {data.title}
      </h2>
      <div class="w-24 h-1 bg-[var(--color-accent-primary)] mx-auto rounded-full"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      
      {data.items.map((item, index) => (
        <div class="glass-panel p-8 rounded-3xl hover-spring group text-center flex flex-col items-center animate-fade-in-up" style={`animation-delay: ${index * 0.1}s`}>
          <div class="w-16 h-16 rounded-2xl bg-[var(--color-accent-primary)]/10 flex items-center justify-center mb-6 text-[var(--color-accent-primary)] border border-white/50 shadow-inner group-hover:scale-110 transition-transform duration-300 mx-auto">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" set:html={item.icon}></svg>
          </div>
          <h3 class="text-2xl font-bold mb-4 text-[var(--color-text-main)]" style="font-family: var(--font-heading)">{item.title}</h3>
          <p class="text-[var(--color-text-muted)] text-sm leading-relaxed">
            {item.desc}
          </p>
        </div>
      ))}

    </div>
  </div>
</section>
