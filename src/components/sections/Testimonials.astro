---
import { testimonialsData } from '../../i18n/data_extended';

interface Props {
  lang?: 'ru' | 'ua';
}
const { lang = 'en' } = Astro.props;
const data = testimonialsData.en;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section class="relative py-24 px-6 z-10">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16 animate-fade-in-up">
      <h2 class="text-4xl md:text-5xl font-bold mb-4 text-[var(--color-text-main)]" style="font-family: var(--font-heading)">
        {data.title}
      </h2>
      <div class="w-24 h-1 bg-[var(--color-accent-primary)] mx-auto rounded-full"></div>
    </div>

    <div class="relative">
      <div id="test-carousel" class="flex md:grid overflow-x-auto md:overflow-x-visible snap-x snap-mandatory md:snap-none grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 pb-4 [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]">
        {[1, 2, 3, 4].map((num) => (
          <div class="glass-panel p-2.5 sm:p-3 rounded-3xl hover-spring flex-shrink-0 w-[88vw] sm:w-[75vw] md:w-auto snap-center md:snap-align-none relative shadow-xl overflow-hidden border border-white/40 dark:border-white/10">
            <img 
              src={`${base}/images/feedback-${num}.png`} 
              alt={`Client review ${num}`} 
              width="768" 
              height="512" 
              loading="lazy" 
              decoding="async" 
              class="w-full h-auto rounded-2xl aspect-[3/2] object-contain block" 
            />
          </div>
        ))}
      </div>

      <!-- Mobile navigation arrows overlay -->
      <button onclick="scrollCarousel('test-carousel', -1)" aria-label="Previous" class="md:hidden absolute left-2 top-1/2 -translate-y-1/2 w-12 h-12 bg-black/40 backdrop-blur-md rounded-full flex items-center justify-center text-white border border-white/20 shadow-xl z-20 hover:bg-black/60 active:scale-90 transition-all pointer-events-auto">
        <svg class="w-6 h-6 ml-[-2px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path></svg>
      </button>
      <button onclick="scrollCarousel('test-carousel', 1)" aria-label="Next" class="md:hidden absolute right-2 top-1/2 -translate-y-1/2 w-12 h-12 bg-black/40 backdrop-blur-md rounded-full flex items-center justify-center text-white border border-white/20 shadow-xl z-20 hover:bg-black/60 active:scale-90 transition-all pointer-events-auto">
        <svg class="w-6 h-6 mr-[-2px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path></svg>
      </button>
    </div>
  </div>
</section>

<script is:inline>
  if (typeof window.scrollCarousel !== 'function') {
    window.scrollCarousel = function(id, direction) {
      const el = document.getElementById(id);
      if (!el) return;
      
      const scrollPos = el.scrollLeft;
      const maxScroll = el.scrollWidth - el.clientWidth;
      const scrollAmount = window.innerWidth * 0.85;

      if (direction === 1) {
        if (scrollPos >= maxScroll - 10) {
          el.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          el.scrollBy({ left: scrollAmount, behavior: 'smooth' });
        }
      } else {
        if (scrollPos <= 10) {
          el.scrollTo({ left: maxScroll, behavior: 'smooth' });
        } else {
          el.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
        }
      }
    };
  }
</script>
