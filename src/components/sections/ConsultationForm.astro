---
import { useTranslations } from '../../i18n/ui';

interface Props {
  lang?: 'ru' | 'ua';
}
const { lang = 'ua' } = Astro.props;
const t = useTranslations(lang);
---
<section class="relative py-24 px-4 sm:px-6 z-10" id="consultation-form">
  <div class="max-w-7xl mx-auto glass-panel p-6 sm:p-10 md:p-16 rounded-[30px] md:rounded-[40px] shadow-2xl border border-[rgba(255,255,255,0.6)] overflow-hidden">

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center relative z-10">
      
      <!-- Text Side -->
      <div>
        <h2 class="text-4xl md:text-5xl font-bold mb-6 text-[var(--color-text-main)] leading-tight" style="font-family: var(--font-heading)">
          {t('form.title1')} <br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-[var(--color-accent-primary)] to-[#00d2ff]">{t('form.title2')}</span>
        </h2>
        <p class="text-lg text-[var(--color-text-muted)] mb-8">
          {t('form.desc')}
        </p>
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-full bg-[rgba(59,130,246,0.1)] flex items-center justify-center text-[var(--color-accent-primary)]">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
          </div>
          <div>
            <div class="text-sm text-[var(--color-text-muted)] mb-1">{t('form.or_call')}</div>
            <div class="flex flex-col gap-1">
              <a href="tel:+380956602238" class="text-xl font-bold text-[var(--color-text-main)] hover:text-[var(--color-accent-primary)] transition-colors">+38 (095) 660 22 38</a>
              <a href="tel:+380976080785" class="text-xl font-bold text-[var(--color-text-main)] hover:text-[var(--color-accent-primary)] transition-colors">+38 (097) 608 07 85</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Form Side -->
      <div class="bg-white/80 backdrop-blur-xl p-4 md:p-8 rounded-3xl border border-white shadow-xl relative">
        <div class="text-center mb-6 md:mb-8">
          <h3 class="text-2xl font-black mb-1" style="font-family: var(--font-heading)">{t('form.box.title1')}</h3>
          <div class="text-[var(--color-accent-primary)] font-bold text-sm tracking-widest uppercase mb-3">{t('form.box.title2')}</div>
          <div class="inline-block bg-[#d32f2f] text-white px-4 py-1.5 rounded-lg text-lg font-bold tracking-widest shadow-md">Mr.Cucaracha</div>
        </div>

        <form action="/telegram.php" method="post" class="space-y-6">
          <input type="hidden" name="type" value="zamer2" />
          <input type="hidden" name="current_url" value={lang === 'ru' ? '/ru/' : '/'} />
          
          <div class="relative">
            <input type="text" name="name" placeholder={lang === 'ua' ? "Ваше ім'я (необов'язково)" : "Ваше имя (необязательно)"} class="w-full px-6 py-5 rounded-2xl bg-white border-2 border-blue-400 shadow-[0_0_15px_rgba(96,165,250,0.3)] focus:outline-none focus:ring-4 focus:ring-blue-300 focus:border-blue-500 transition-all text-[var(--color-text-main)] placeholder-[var(--color-text-muted)] font-bold text-xl text-center" />
          </div>

          <div class="relative">
            <input type="text" name="tel" placeholder={t('form.input')} maxlength="13" required class="w-full px-6 py-5 rounded-2xl bg-white border-2 border-blue-400 shadow-[0_0_15px_rgba(96,165,250,0.3)] focus:outline-none focus:ring-4 focus:ring-blue-300 focus:border-blue-500 transition-all text-[var(--color-text-main)] placeholder-[var(--color-text-muted)] font-bold text-xl text-center" />
          </div>

          <button type="submit" class="w-full py-5 rounded-2xl bg-[var(--color-accent-primary)] text-white font-bold text-lg uppercase tracking-wider hover:bg-[var(--color-accent-hover)] transition-all shadow-lg hover:shadow-xl">
            {t('form.submit')}
          </button>
        </form>
      </div>

    </div>
  </div>
</section>

<!-- Success Modal Overlay -->
<div id="success-modal" class="fixed inset-0 bg-[rgba(15,23,42,0.8)] backdrop-blur-md z-[100] flex items-center justify-center opacity-0 pointer-events-none transition-all duration-500 ease-[var(--ease-spring)]">
  <div id="success-modal-content" class="bg-white p-8 md:p-12 rounded-[30px] shadow-2xl max-w-md w-full mx-4 transform scale-90 translate-y-8 transition-all duration-500 ease-[var(--ease-spring)] text-center relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-[rgba(59,130,246,0.1)] to-transparent pointer-events-none"></div>
    
    <div class="w-24 h-24 mx-auto bg-green-100 text-green-500 rounded-full flex items-center justify-center mb-6 shadow-inner relative">
      <div class="absolute inset-0 bg-green-400 rounded-full blur-xl opacity-20"></div>
      <svg class="w-12 h-12 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
    </div>
    
    <h3 id="modal-title" class="text-3xl font-black text-[var(--color-text-main)] mb-4" style="font-family: var(--font-heading)">Успешно!</h3>
    <p id="modal-desc" class="text-[var(--color-text-muted)] text-lg mb-8 leading-relaxed">Ваша заявка успешно отправлена! Менеджер свяжется с вами в ближайшее время.</p>
    
    <button id="modal-close-btn" class="w-full relative px-8 py-4 bg-gradient-to-r from-[var(--color-accent-primary)] to-[var(--color-accent-dark)] text-white font-bold text-lg rounded-2xl shadow-xl hover:shadow-2xl hover:scale-[1.02] active:scale-95 transition-all duration-300">
      Отлично
    </button>
  </div>
</div>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    // Valid Ukrainian operator codes
    const validOperators = ['39','50','63','66','67','68','73','91','92','93','94','95','96','97','98','99'];
    
    // 1. Phone Input Formatting
    const phoneInputs = document.querySelectorAll('input[name="tel"]');
    phoneInputs.forEach(input => {
      input.addEventListener('focus', () => {
        if (!input.value.startsWith('+380')) {
          input.value = '+380';
        }
      });
      
      input.addEventListener('input', () => {
        let val = input.value.replace(/[^\d+]/g, '');
        if (!val.startsWith('+380')) {
          val = '+380' + val.replace(/^\+?3?8?0?/, '');
        }
        input.value = val.substring(0, 13); // +380 + 9 digits = 13 characters
      });
      
      input.addEventListener('keydown', (e) => {
        // Prevent deleting the +380 prefix
        if (input.selectionStart <= 4 && (e.key === 'Backspace' || e.key === 'Delete')) {
          e.preventDefault();
        }
      });
    });

    const forms = document.querySelectorAll('form[action="/telegram.php"]');
    const modal = document.getElementById('success-modal');
    const modalContent = document.getElementById('success-modal-content');
    const modalTitle = document.getElementById('modal-title');
    const modalDesc = document.getElementById('modal-desc');
    const modalBtn = document.getElementById('modal-close-btn');
    
    // Move modal to body to avoid stacking context issues
    if (modal && modal.parentNode !== document.body) {
      document.body.appendChild(modal);
    }
    
    forms.forEach(form => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const phoneInput = form.querySelector('input[name="tel"]');
        const phoneVal = phoneInput.value;
        const currentUrl = form.querySelector('input[name="current_url"]')?.value || '/';
        const isRu = currentUrl.includes('/ru');
        
        // --- Validation ---
        if (phoneVal.length !== 13) {
          alert(isRu ? 'Пожалуйста, введите полный номер телефона (13 символов): +380XXXXXXXXX' : 'Будь ласка, введіть повний номер телефону (13 символів): +380XXXXXXXXX');
          return;
        }
        
        const operatorCode = phoneVal.substring(4, 6);
        if (!validOperators.includes(operatorCode)) {
          alert(isRu ? 'Введен неверный код мобильного оператора Украины.' : 'Введено невірний код мобільного оператора України.');
          return;
        }

        // --- Anti-spam (Cooldown) ---
        const lastSubmit = localStorage.getItem('cucaracha_last_submit');
        const now = Date.now();
        // 60 seconds cooldown
        if (lastSubmit && (now - parseInt(lastSubmit)) < 60000) {
          alert(isRu ? 'Вы уже недавно отправляли заявку. Пожалуйста, подождите минуту перед следующей отправкой.' : 'Ви вже нещодавно відправляли заявку. Будь ласка, зачекайте хвилину перед наступною відправкою.');
          return;
        }
        
        const submitBtn = form.querySelector('button[type="submit"]');
        const originalText = submitBtn.innerHTML;
        
        // Disable button to prevent double submission
        submitBtn.style.pointerEvents = 'none';
        submitBtn.style.opacity = '0.7';
        submitBtn.innerHTML = isRu ? 'Отправка...' : 'Відправлення...';
        
        try {
          const formData = new FormData(form);
          const response = await fetch('/telegram.php', {
            method: 'POST',
            body: formData
          });
          
          if (!response.ok) {
            throw new Error(`HTTP error! status: ${response.status}`);
          }
          
          const result = await response.json();
          if (result.status === 'error') {
            throw new Error(result.message);
          }
          
          // Save submission time for anti-spam
          localStorage.setItem('cucaracha_last_submit', now.toString());
          
          // Push successful submission event to Google Tag Manager
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({
            'event': 'form_submission_success',
            'form_action': '/telegram.php'
          });

          // Setup and show modal
          if (modal && modalContent && modalTitle && modalDesc && modalBtn) {
            modalTitle.textContent = isRu ? 'Успешно!' : 'Успішно!';
            modalDesc.textContent = isRu 
              ? 'Ваша заявка успешно отправлена! Менеджер свяжется с вами в ближайшее время.' 
              : 'Заявку успішно відправлено! Менеджер зв\'яжеться з вами найближчим часом.';
            modalBtn.textContent = isRu ? 'Отлично' : 'Чудово';
            
            modal.classList.remove('opacity-0', 'pointer-events-none');
            modalContent.classList.remove('scale-90', 'translate-y-8');
            modalContent.classList.add('scale-100', 'translate-y-0');
            
            const closeAndRedirect = () => {
              window.location.href = isRu ? '/ru' : '/';
            };
            
            modalBtn.onclick = closeAndRedirect;
          } else {
            // Fallback
            alert(isRu ? 'Заявка успешно отправлена!' : 'Заявку успішно відправлено!');
            window.location.href = isRu ? '/ru' : '/';
          }
          
        } catch (error) {
          console.error('Error submitting form:', error);
          const errorMsg = isRu 
            ? 'Произошла ошибка при отправке. Пожалуйста, позвоните нам по телефону.' 
            : 'Сталася помилка при відправленні. Будь ласка, зателефонуйте нам.';
          
          alert(errorMsg);
          
          // Restore button
          submitBtn.style.pointerEvents = 'auto';
          submitBtn.style.opacity = '1';
          submitBtn.innerHTML = originalText;
        }
      });
    });
  });
</script>
