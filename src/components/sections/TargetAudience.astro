---
import { targetAudienceData } from '../../i18n/data';

interface Props {
  lang?: 'ru' | 'ua';
}
const { lang = 'en' } = Astro.props;
const data = targetAudienceData.en;
---
<section class="relative py-24 px-6 z-10">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16 animate-fade-in-up">
      <h2 class="text-4xl md:text-5xl font-bold mb-4 text-[var(--color-text-main)]" style="font-family: var(--font-heading)">
        {lang === 'ua' ? 'Для кого наші послуги' : 'Для кого наши услуги'}
      </h2>
      <div class="w-24 h-1 bg-[var(--color-accent-primary)] mx-auto rounded-full"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      
      {data.map((item, index) => (
        <div class="glass-panel p-8 rounded-3xl hover-spring group relative overflow-hidden animate-fade-in-up text-center flex flex-col items-center" style={`animation-delay: ${index * 0.1}s`}>
          <div class="absolute -right-10 -top-10 w-40 h-40 bg-[var(--color-accent-primary)] rounded-full blur-3xl opacity-0 group-hover:opacity-10 transition-opacity duration-500"></div>
          
          <div class="w-14 h-14 rounded-2xl bg-white/10 flex items-center justify-center mb-6 text-[var(--color-accent-primary)] border border-white/20 shadow-inner group-hover:scale-110 transition-transform duration-300">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={item.icon}></svg>
          </div>
          
          <h3 class="text-xl font-bold mb-3 text-[var(--color-text-main)]" style="font-family: var(--font-heading)">{item.title}</h3>
          <p class="text-[var(--color-text-muted)] leading-relaxed text-sm">
            {item.desc}
          </p>
        </div>
      ))}
      
    </div>
  </div>
</section>
