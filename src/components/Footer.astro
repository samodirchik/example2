---
import { useTranslations } from '../i18n/ui';
import { routes } from '../i18n/routes';

interface Props {
  lang?: 'ru' | 'ua' | 'en';
}
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---
<footer class="glass-panel mt-12 py-4 lg:py-6 relative z-10 border-t border-[rgba(255,255,255,0.4)]">
  <div class="max-w-5xl mx-auto px-4">
    <div class="flex flex-col lg:flex-row justify-between items-center gap-6">
      
      <!-- Logo and Description -->
      <div class="flex flex-col items-center lg:items-start text-center lg:text-left">
        <a href={routes.home} class="text-2xl font-bold tracking-tighter hover:text-[var(--color-accent-primary)] transition-colors" style="font-family: var(--font-heading)">CUCARACHA</a>
        <div class="text-[10px] text-[var(--color-text-muted)] uppercase tracking-widest mt-2 max-w-xs">
          {t('footer.desc')}
        </div>
      </div>

      <!-- Contacts & Copyright -->
      <div class="flex flex-col items-center lg:items-end gap-4">
        
        <div class="flex flex-col items-center lg:items-end gap-1">
          <a href="tel:+380956602238" class="text-xl lg:text-lg font-bold text-[var(--color-text-main)] hover:text-[var(--color-accent-primary)] transition-colors leading-tight">+ 38 (095) 660 22 38</a>
          <a href="tel:+380976080785" class="text-xl lg:text-lg font-bold text-[var(--color-text-main)] hover:text-[var(--color-accent-primary)] transition-colors leading-tight">+ 38 (097) 608 07 85</a>
          <span class="text-[10px] text-[var(--color-text-muted)] font-medium mt-1 uppercase tracking-wide">{t('header.247')}</span>
        </div>
        
        <!-- Copyright -->
        <div class="text-[10px] text-[var(--color-text-muted)] flex flex-col items-center lg:items-end gap-1">
          <span>&copy; {new Date().getFullYear()} CUCARACHA. {t('footer.rights')}</span>
        </div>
        
      </div>
      
    </div>
  </div>
</footer>
