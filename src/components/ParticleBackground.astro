---
// ParticleBackground.astro
---
<div id="particle-container" class="absolute inset-0 z-0 overflow-hidden pointer-events-none"></div>

<script>
  // DOM-based insect animation using CSS GPU transforms (translate3d) for smooth rendering

  class CyberRoachDOM {
    el: HTMLDivElement;
    x: number;
    y: number;
    vx: number;
    vy: number;
    speed: number;
    targetVx: number;
    targetVy: number;
    isStopped: boolean;
    stateTimer: number;

    constructor(x: number, y: number, container: HTMLElement) {
      this.x = x;
      this.y = y;
      
      this.speed = Math.random() * 0.6 + 0.3; 
      const angle = Math.random() * Math.PI * 2;
      this.targetVx = Math.cos(angle) * this.speed;
      this.targetVy = Math.sin(angle) * this.speed;
      this.vx = this.targetVx;
      this.vy = this.targetVy;
      
      this.isStopped = false;
      this.stateTimer = Math.random() * 200;

      const colors = [
        'rgba(139, 69, 19, 0.95)',   
        'rgba(160, 82, 45, 0.95)',   
        'rgba(101, 67, 33, 0.95)',
        'rgba(120, 50, 20, 0.95)'    
      ];
      const color = colors[Math.floor(Math.random() * colors.length)];

      this.el = document.createElement('div');
      this.el.style.position = 'absolute';
      this.el.style.left = '-12px';
      this.el.style.top = '-12px';
      this.el.style.width = '24px';
      this.el.style.height = '24px';
      this.el.style.color = color;
      this.el.style.zIndex = '1';
      this.el.style.pointerEvents = 'none';
      this.el.style.willChange = 'transform';
      
      const scale = Math.random() * 0.4 + 0.85;
      
      // Vector SVG Roach
      this.el.innerHTML = `
        <svg width="24" height="24" viewBox="-12 -12 24 24" style="display:block; transform: scale(${scale});">
          <g stroke="currentColor" fill="currentColor" stroke-width="1.3" stroke-linecap="round">
            <ellipse cx="0" cy="0" rx="6" ry="3" />
            <line x1="5" y1="-1" x2="12" y2="-4.5" />
            <line x1="5" y1="1" x2="12" y2="4.5" />
            <line x1="-2.5" y1="-2.5" x2="-6" y2="-7.5" />
            <line x1="-2.5" y1="2.5" x2="-6" y2="7.5" />
            <line x1="0" y1="-2.5" x2="-1" y2="-7.5" />
            <line x1="0" y1="2.5" x2="-1" y2="7.5" />
            <line x1="2.5" y1="-2.5" x2="4" y2="-7.5" />
            <line x1="2.5" y1="2.5" x2="4" y2="7.5" />
          </g>
        </svg>
      `;
      container.appendChild(this.el);
    }

    update(mouse: {x: number, y: number, radius: number}, width: number, height: number, dt: number) {
      const margin = 50;
      if (this.x > width + margin) this.x = -margin;
      if (this.x < -margin) this.x = width + margin;
      if (this.y > height + margin) this.y = -margin;
      if (this.y < -margin) this.y = height + margin;

      let dx = this.x - mouse.x;
      let dy = this.y - mouse.y;
      let distance = Math.sqrt(dx * dx + dy * dy);
      
      let isEscaping = false;

      if (distance < mouse.radius) {
        isEscaping = true;
        this.isStopped = false;
        
        let force = Math.max(0.2, (mouse.radius - distance) / mouse.radius);
        let scatterSpeed = 10 * force; 
        
        this.targetVx = (dx / distance) * scatterSpeed;
        this.targetVy = (dy / distance) * scatterSpeed;
      } else {
        this.stateTimer -= dt;
        
        if (this.stateTimer <= 0) {
          if (this.isStopped) {
            this.isStopped = false;
            const angle = Math.random() * Math.PI * 2;
            this.targetVx = Math.cos(angle) * this.speed;
            this.targetVy = Math.sin(angle) * this.speed;
            this.stateTimer = Math.random() * 200 + 100;
          } else {
            if (Math.random() < 0.25) {
              this.isStopped = true;
              this.targetVx = 0;
              this.targetVy = 0;
              this.stateTimer = Math.random() * 100 + 50;
            } else {
              const angle = Math.atan2(this.targetVy, this.targetVx) + (Math.random() - 0.5);
              this.targetVx = Math.cos(angle) * this.speed;
              this.targetVy = Math.sin(angle) * this.speed;
              this.stateTimer = Math.random() * 200 + 100;
            }
          }
        }
      }

      let accel = isEscaping ? 0.4 : 0.05;
      this.vx += (this.targetVx - this.vx) * accel * dt;
      this.vy += (this.targetVy - this.vy) * accel * dt;

      this.x += this.vx * dt;
      this.y += this.vy * dt;

      // GPU-accelerated translate3d transform for subpixel smoothness
      const angle = Math.atan2(this.vy, this.vx);
      this.el.style.transform = `translate3d(${this.x}px, ${this.y}px, 0) rotate(${angle}rad)`;
    }
  }

  let animationFrameId: number;

  function initSwarm() {
    const container = document.getElementById('particle-container');
    if (!container) return;
    
    // Clear previous if any
    container.innerHTML = '';
    if (animationFrameId) {
      cancelAnimationFrame(animationFrameId);
    }

    let cssWidth = Math.max(container.offsetWidth, window.innerWidth);
    let cssHeight = Math.max(container.offsetHeight, window.innerHeight);
    container.style.height = cssHeight + 'px';

    let bugs: CyberRoachDOM[] = [];

    const isMobile = window.innerWidth <= 768;
    const mouse = {
      x: -1000,
      y: -1000,
      radius: isMobile ? 80 : 130
    };

    function resize() {
      if (!container) return;
      cssWidth = Math.max(container.offsetWidth, window.innerWidth);
      cssHeight = Math.max(document.documentElement.scrollHeight, document.body.scrollHeight, window.innerHeight);
      container.style.height = cssHeight + 'px';
    }

    const numberOfBugs = isMobile ? 12 : Math.min(30, Math.max(16, Math.floor(cssHeight / 250))); 
    for (let i = 0; i < numberOfBugs; i++) {
      let x = Math.random() * cssWidth;
      let y = Math.random() * cssHeight;
      bugs.push(new CyberRoachDOM(x, y, container));
    }

    let lastTime = 0;
    let isVisible = true;

    function animate(time: number) {
      if (!isVisible) return;
      
      animationFrameId = requestAnimationFrame(animate);
      if (!lastTime) lastTime = time;
      const dt = Math.min((time - lastTime) / 16.666, 2.5);
      lastTime = time;

      for (let i = 0; i < bugs.length; i++) {
        bugs[i].update(mouse, cssWidth, cssHeight, dt);
      }
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        isVisible = entry.isIntersecting;
        if (isVisible) {
          lastTime = performance.now();
          animationFrameId = requestAnimationFrame(animate);
        } else {
          cancelAnimationFrame(animationFrameId);
        }
      });
    }, { threshold: 0 });
    
    observer.observe(container);

    window.addEventListener('resize', () => {
      mouse.radius = window.innerWidth <= 768 ? 80 : 130;
      resize();
    }, { passive: true });

    window.addEventListener('mousemove', (event) => {
      if (!isVisible || !container) return;
      const rect = container.getBoundingClientRect();
      mouse.x = event.clientX - rect.left;
      mouse.y = event.clientY - rect.top;
    }, { passive: true });

    window.addEventListener('mouseleave', () => {
      mouse.x = -1000;
      mouse.y = -1000;
    }, { passive: true });

    window.addEventListener('touchstart', (event) => {
      if (!isVisible || !container || event.touches.length === 0) return;
      const rect = container.getBoundingClientRect();
      mouse.x = event.touches[0].clientX - rect.left;
      mouse.y = event.touches[0].clientY - rect.top;
    }, { passive: true });
    
    window.addEventListener('touchmove', (event) => {
      if (!isVisible || !container || event.touches.length === 0) return;
      const rect = container.getBoundingClientRect();
      mouse.x = event.touches[0].clientX - rect.left;
      mouse.y = event.touches[0].clientY - rect.top;
    }, { passive: true });

    resize();
    lastTime = performance.now();
    animationFrameId = requestAnimationFrame(animate);
  }

  // Safe single initialization
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      if ('requestIdleCallback' in window) {
        requestIdleCallback(initSwarm);
      } else {
        setTimeout(initSwarm, 100);
      }
    }, { once: true });
  } else {
    if ('requestIdleCallback' in window) {
      requestIdleCallback(initSwarm);
    } else {
      setTimeout(initSwarm, 100);
    }
  }
  document.addEventListener('astro:page-load', () => {
    initSwarm();
  });
</script>
