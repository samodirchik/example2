---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsultationForm from '../components/sections/ConsultationForm.astro';
import ParticleBackground from '../components/ParticleBackground.astro';

const lang = 'ru';
---

<Layout title="⭐Контакты - Cucaracha - Служба дезінсекції (дезінфекції)" description="✅Вызвать службу дезинсеции (дезинфекции).⭐Гарантия 12 месяцев.💰Цены от 500 грн.🔒Безопасно для людей и животных" lang={lang}>
  <ParticleBackground />
  <Header lang={lang} />
  
  <main class="pt-32 pb-16 relative z-10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumbs -->
      <nav class="flex text-sm text-[var(--color-text-muted)] mb-8 font-medium">
        <ol class="flex items-center space-x-2">
          <li>
            <a href="/ru" class="hover:text-[var(--color-accent-primary)] transition-colors">Главная</a>
          </li>
          <li><span class="mx-2">/</span></li>
          <li class="text-[var(--color-text-main)]">
            Контакты
          </li>
        </ol>
      </nav>

      <div class="glass-panel p-8 md:p-12 rounded-3xl shadow-xl">
        <h1 class="text-4xl md:text-5xl font-black mb-8 text-[var(--color-text-main)] tracking-tight leading-tight">
          Контакты
        </h1>
        
        <div class="flex flex-col gap-6 mt-6">
          
          <!-- Location -->
          <div class="flex items-start gap-4 md:gap-5 p-5 md:p-8 bg-white/60 backdrop-blur-md rounded-3xl border border-[rgba(0,0,0,0.03)] shadow-[0_8px_30px_rgb(0,0,0,0.04)] hover:shadow-[0_8px_30px_rgb(0,0,0,0.08)] transition-all group">
            <div class="w-12 h-12 md:w-14 md:h-14 flex-shrink-0 bg-blue-50 text-blue-600 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300 shadow-sm">
              <svg class="w-5 h-5 md:w-6 md:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            </div>
            <div>
              <h3 class="text-lg md:text-xl font-bold text-[var(--color-text-main)] mb-2 md:mb-3 leading-tight">Работаем по всей Украине</h3>
              <p class="text-[var(--color-text-muted)] text-xs md:text-sm leading-relaxed">Киев, Днепр, Одесса, Харьков, Запорожье, Кривой Рог, Черкассы, Николаев, Каменское, Павлоград, Львов, Хмельницкий, Каменец-Подольский, Тернополь, Винница, Сумы, Чернигов, Черновцы, Ивано-Франковск, Ровно, Полтава, Кременчуг</p>
            </div>
          </div>

          <!-- Phones -->
          <div class="flex items-start gap-4 md:gap-5 p-5 md:p-8 bg-white/60 backdrop-blur-md rounded-3xl border border-[rgba(0,0,0,0.03)] shadow-[0_8px_30px_rgb(0,0,0,0.04)] hover:shadow-[0_8px_30px_rgb(0,0,0,0.08)] transition-all group">
            <div class="w-12 h-12 md:w-14 md:h-14 flex-shrink-0 bg-green-50 text-green-600 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300 shadow-sm">
              <svg class="w-5 h-5 md:w-6 md:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            </div>
            <div>
              <h3 class="text-lg md:text-xl font-bold text-[var(--color-text-main)] mb-2 md:mb-3 leading-tight">Телефоны</h3>
              <div class="flex flex-col gap-2">
                <span class="text-[10px] text-[var(--color-text-muted)] uppercase tracking-widest font-bold">Для населения:</span>
                <a href="tel:+380956602238" class="text-base md:text-xl font-black text-[var(--color-text-main)] hover:text-green-600 transition-colors tracking-tight whitespace-nowrap">+ 38 (095) 660 22 38</a>
                <a href="tel:+380976080785" class="text-base md:text-xl font-black text-[var(--color-text-main)] hover:text-green-600 transition-colors tracking-tight whitespace-nowrap">+ 38 (097) 608 07 85</a>
              </div>
            </div>
          </div>

          <!-- Email -->
          <div class="flex items-start gap-4 md:gap-5 p-5 md:p-8 bg-white/60 backdrop-blur-md rounded-3xl border border-[rgba(0,0,0,0.03)] shadow-[0_8px_30px_rgb(0,0,0,0.04)] hover:shadow-[0_8px_30px_rgb(0,0,0,0.08)] transition-all group">
            <div class="w-12 h-12 md:w-14 md:h-14 flex-shrink-0 bg-purple-50 text-purple-600 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300 shadow-sm">
              <svg class="w-5 h-5 md:w-6 md:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            </div>
            <div class="overflow-hidden">
              <h3 class="text-lg md:text-xl font-bold text-[var(--color-text-main)] mb-2 md:mb-3 leading-tight">Пишите нам</h3>
              <a href="mailto:Cucaracha.com.ua@gmail.com" class="text-base md:text-xl font-black text-[var(--color-text-main)] hover:text-purple-600 transition-colors tracking-tight truncate block">Cucaracha.com.ua@gmail.com</a>
            </div>
          </div>

          <!-- Schedule -->
          <div class="flex items-start gap-4 md:gap-5 p-5 md:p-8 bg-white/60 backdrop-blur-md rounded-3xl border border-[rgba(0,0,0,0.03)] shadow-[0_8px_30px_rgb(0,0,0,0.04)] hover:shadow-[0_8px_30px_rgb(0,0,0,0.08)] transition-all group">
            <div class="w-12 h-12 md:w-14 md:h-14 flex-shrink-0 bg-orange-50 text-orange-600 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300 shadow-sm">
              <svg class="w-5 h-5 md:w-6 md:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <div>
              <h3 class="text-lg md:text-xl font-bold text-[var(--color-text-main)] mb-2 md:mb-3 leading-tight">Время работы</h3>
              <div class="flex flex-col gap-2">
                <p class="text-xs md:text-sm text-[var(--color-text-muted)] leading-relaxed"><strong class="text-[var(--color-text-main)] block mb-0.5">Прием заказов и консультации:</strong> 24/7 без выходных</p>
                <p class="text-xs md:text-sm text-[var(--color-text-muted)] leading-relaxed"><strong class="text-[var(--color-text-main)] block mb-0.5">Предоставление услуг:</strong> круглосуточно</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
  
  <ConsultationForm lang={lang} />
  <Footer lang={lang} />
</Layout>
