---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ConsultationForm from '../../components/sections/ConsultationForm.astro';
import ParticleBackground from '../../components/ParticleBackground.astro';
---

<Layout title="Ant Extermination Service - Cucaracha" description="Total eradication of ant colonies and foraging trails in apartments, houses, and gardens. Destruction of queen and subterranean nests.">
  <ParticleBackground />
  <Header />
  
  <main class="pt-32 pb-16 relative z-10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumbs -->
      <nav class="flex text-sm text-[var(--color-text-muted)] mb-8 font-medium">
        <ol class="flex items-center space-x-2">
          <li>
            <a href="/" class="hover:text-[var(--color-accent-primary)] transition-colors">Home</a>
          </li>
          <li><span class="mx-2">/</span></li>
          <li>
            <span class="hover:text-[var(--color-accent-primary)] transition-colors">Disinsection</span>
          </li>
          <li><span class="mx-2">/</span></li>
          <li class="text-[var(--color-text-main)]">
            Ants
          </li>
        </ol>
      </nav>

      <div class="glass-panel p-8 md:p-12 rounded-3xl shadow-xl">
        <h1 class="text-4xl md:text-5xl font-black mb-8 text-[var(--color-text-main)] tracking-tight leading-tight">
          Ant Extermination
        </h1>
        
        <div class="prose prose-lg prose-headings:font-bold prose-headings:text-[var(--color-text-main)] prose-p:text-[var(--color-text-muted)] prose-img:rounded-2xl prose-img:shadow-lg max-w-none">
          <p class="text-xl font-medium text-[var(--color-text-main)] mb-8">
            Ants infiltrate kitchens, pantries, wall voids, and terrace foundations in large colonies, contaminating foodstuffs and establishing persistent trails.
          </p>

          <h2 class="text-2xl mt-10 mb-4">Risks and Threats</h2>
          <p class="mb-6">
            Pharaoh ants and garden ants spread bacteria from refuse bins across clean dishes and countertops, damaging building insulation and ruining food supplies.
          </p>

          <div class="my-8">
<figure class="wp-block-image size-large"><img fetchpriority="high" decoding="async" width="1024" height="768" src="/images/wp-content/uploads/2024/03/ants_ant_anthill_nature-1-1024x768.jpg" alt="Ants" class="wp-image-294" style="aspect-ratio:16/9;object-fit:cover" title="Ants" srcset="/images/wp-content/uploads/2024/03/ants_ant_anthill_nature-1-1024x768.jpg 1024w, /images/wp-content/uploads/2024/03/ants_ant_anthill_nature-1-300x225.jpg 300w, /images/wp-content/uploads/2024/03/ants_ant_anthill_nature-1-768x576.jpg 768w, /images/wp-content/uploads/2024/03/ants_ant_anthill_nature-1.jpg 1366w" sizes="(max-width: 1024px) 100vw, 1024px" /></figure>

<figure class="wp-block-image size-large"><img decoding="async" width="1024" height="676" src="/images/wp-content/uploads/2024/03/Pest-control-service-worker-for-kids-vector-illustrations-set-9-1024x676.jpg" alt="Ants" class="wp-image-295" style="aspect-ratio:16/9;object-fit:cover" title="Ants" srcset="/images/wp-content/uploads/2024/03/Pest-control-service-worker-for-kids-vector-illustrations-set-9-1024x676.jpg 1024w, /images/wp-content/uploads/2024/03/Pest-control-service-worker-for-kids-vector-illustrations-set-9-300x198.jpg 300w, /images/wp-content/uploads/2024/03/Pest-control-service-worker-for-kids-vector-illustrations-set-9-768x507.jpg 768w, /images/wp-content/uploads/2024/03/Pest-control-service-worker-for-kids-vector-illustrations-set-9-1536x1014.jpg 1536w, /images/wp-content/uploads/2024/03/Pest-control-service-worker-for-kids-vector-illustrations-set-9-2048x1352.jpg 2048w" sizes="(max-width: 1024px) 100vw, 1024px" /></figure>
</div>

          <h2 class="text-2xl mt-10 mb-4">Professional Extermination Process</h2>
          <p class="mb-4">
            Our certified specialists deploy industry-leading methodologies to eradicate infestations quickly, completely, and safely:
          </p>
          <ul class="space-y-3 mb-8">
            <li><span>Tracing foraging lines to locate central underground or intramural nest colonies and queens;</span></li>
            <li><span>Deployment of delayed-action cascade gel baits transported by workers directly into the nest core;</span></li>
            <li><span>Barrier spraying of entry thresholds, pipe sleeves, and foundations;</span></li>
            <li><span>Targeted outdoor soil treatment for garden anthills;</span></li>
            <li><span>12-month warranty against ant reinfestation.</span></li>
          </ul>

          <h2 class="text-2xl mt-10 mb-4">Why Choose Cucaracha?</h2>
          <p class="mb-4">
            With over 9 years of field experience and 11,000+ satisfied clients across Ukraine, Cucaracha guarantees unparalleled service standards:
          </p>
          <ul class="space-y-3 mb-8">
            <li><span><strong>12-Month Quality Warranty</strong> — complete peace of mind with free follow-up treatments if needed;</span></li>
            <li><span><strong>Certified European Formulations</strong> — maximum pest lethality with zero risk to humans and domestic pets;</span></li>
            <li><span><strong>Rapid 24/7 Response</strong> — expert technicians available around the clock across all major cities;</span></li>
            <li><span><strong>Transparent Pricing</strong> — starting from 500 UAH with no hidden costs or unnecessary add-ons.</span></li>
          </ul>

          <div class="p-6 rounded-2xl bg-[rgba(var(--color-accent-primary-rgb,67,97,238),0.06)] border border-[rgba(var(--color-accent-primary-rgb,67,97,238),0.15)] my-8">
            <h3 class="text-xl font-bold text-[var(--color-text-main)] mb-2">Need Urgent Assistance?</h3>
            <p class="text-[var(--color-text-muted)] mb-4">
              Contact our dispatch team right away or leave a callback request. Our specialist will assess your situation and arrive with full equipment.
            </p>
            <div class="flex flex-wrap gap-4 text-base font-bold text-[var(--color-accent-primary)]">
              <a href="tel:+380956602238" class="hover:underline">+38 (095) 660 22 38</a>
              <span class="text-gray-300">|</span>
              <a href="tel:+380976080785" class="hover:underline">+38 (097) 608 07 85</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
  
  <ConsultationForm />
  <Footer />
</Layout>
