---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ConsultationForm from '../../components/sections/ConsultationForm.astro';
import ParticleBackground from '../../components/ParticleBackground.astro';
---

<Layout title="Woodlice & Silverfish Extermination - Cucaracha" description="Eliminate silverfish and woodlice in bathrooms, kitchens, and basements. Targeted, odorless treatments with lasting moisture defense.">
  <ParticleBackground />
  <Header />
  
  <main class="pt-32 pb-16 relative z-10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumbs -->
      <nav class="flex text-sm text-[var(--color-text-muted)] mb-8 font-medium">
        <ol class="flex items-center space-x-2">
          <li>
            <a href="/" class="hover:text-[var(--color-accent-primary)] transition-colors">Home</a>
          </li>
          <li><span class="mx-2">/</span></li>
          <li>
            <span class="hover:text-[var(--color-accent-primary)] transition-colors">Pest Control</span>
          </li>
          <li><span class="mx-2">/</span></li>
          <li class="text-[var(--color-text-main)]">
            Woodlice & Silverfish
          </li>
        </ol>
      </nav>

      <div class="glass-panel p-8 md:p-12 rounded-3xl shadow-xl">
        <h1 class="text-4xl md:text-5xl font-black mb-8 text-[var(--color-text-main)] tracking-tight leading-tight">
          Woodlice & Silverfish Extermination
        </h1>
        
        <div class="prose prose-lg prose-headings:font-bold prose-headings:text-[var(--color-text-main)] prose-p:text-[var(--color-text-muted)] prose-img:rounded-2xl prose-img:shadow-lg max-w-none">
          <p class="text-xl font-medium text-[var(--color-text-main)] mb-8">
            Woodlice and silverfish thrive in damp, dark micro-climates, such as under bathroom tiles, behind plumbing enclosures, and inside damp basements.
          </p>

          <h2 class="text-2xl mt-10 mb-4">Risks and Threats</h2>
          <p class="mb-6">
            Silverfish feed on carbohydrates like paper, wallpaper glue, bookbindings, and starch-rich pantry goods, while woodlice populations indicate moisture leakage and decay.
          </p>

          <div class="my-8">
<figure class="wp-block-image size-large"><img fetchpriority="high" decoding="async" width="1024" height="683" src="/images/wp-content/uploads/2024/03/closeup-purple-form-common-rough-woodlouse-porcel-1-1024x683.jpg" alt="Woodlice & Silverfish" class="wp-image-380" style="aspect-ratio:16/9;object-fit:cover" title="Woodlice & Silverfish" srcset="/images/wp-content/uploads/2024/03/closeup-purple-form-common-rough-woodlouse-porcel-1-1024x683.jpg 1024w, /images/wp-content/uploads/2024/03/closeup-purple-form-common-rough-woodlouse-porcel-1-300x200.jpg 300w, /images/wp-content/uploads/2024/03/closeup-purple-form-common-rough-woodlouse-porcel-1-768x512.jpg 768w, /images/wp-content/uploads/2024/03/closeup-purple-form-common-rough-woodlouse-porcel-1-1536x1024.jpg 1536w, /images/wp-content/uploads/2024/03/closeup-purple-form-common-rough-woodlouse-porcel-1-2048x1365.jpg 2048w" sizes="(max-width: 1024px) 100vw, 1024px" /></figure>

<figure class="wp-block-image size-large"><img decoding="async" width="1024" height="676" src="/images/wp-content/uploads/2024/03/Pest-control-service-worker-for-kids-vector-illustrations-set-28-1024x676.jpg" alt="Woodlice & Silverfish" class="wp-image-378" style="aspect-ratio:16/9;object-fit:cover" title="Woodlice & Silverfish" srcset="/images/wp-content/uploads/2024/03/Pest-control-service-worker-for-kids-vector-illustrations-set-28-1024x676.jpg 1024w, /images/wp-content/uploads/2024/03/Pest-control-service-worker-for-kids-vector-illustrations-set-28-300x198.jpg 300w, /images/wp-content/uploads/2024/03/Pest-control-service-worker-for-kids-vector-illustrations-set-28-768x507.jpg 768w, /images/wp-content/uploads/2024/03/Pest-control-service-worker-for-kids-vector-illustrations-set-28-1536x1014.jpg 1536w, /images/wp-content/uploads/2024/03/Pest-control-service-worker-for-kids-vector-illustrations-set-28-2048x1352.jpg 2048w" sizes="(max-width: 1024px) 100vw, 1024px" /></figure>
</div>

          <h2 class="text-2xl mt-10 mb-4">Professional Extermination Process</h2>
          <p class="mb-4">
            Our certified specialists deploy industry-leading methodologies to eradicate infestations quickly, completely, and safely:
          </p>
          <ul class="space-y-3 mb-8">
            <li><span>Identification of moisture-heavy harboring cracks, tile joints, and plumbing conduits;</span></li>
            <li><span>Microencapsulated insecticidal spraying behind baseboards, under fixtures, and into pipe channels;</span></li>
            <li><span>Fine powder and gel placement in dry voids to provide sustained contact elimination;</span></li>
            <li><span>Preventive barrier along drainage pipes and ventilation grills;</span></li>
            <li><span>12-month quality guarantee.</span></li>
          </ul>

          <h2 class="text-2xl mt-10 mb-4">Why Choose Cucaracha?</h2>
          <p class="mb-4">
            With over 9 years of field experience and 11,000+ satisfied clients, Cucaracha guarantees unparalleled service standards:
          </p>
          <ul class="space-y-3 mb-8">
            <li><span><strong>12-Month Quality Warranty</strong> — complete peace of mind with free follow-up treatments if needed;</span></li>
            <li><span><strong>EPA-Registered Formulations</strong> — maximum pest lethality with zero risk to humans and domestic pets;</span></li>
            <li><span><strong>Rapid 24/7 Response</strong> — expert technicians available around the clock across all major cities;</span></li>
            <li><span><strong>Transparent Pricing</strong> — starting from  with no hidden costs or unnecessary add-ons.</span></li>
          </ul>

          <div class="p-6 rounded-2xl bg-[rgba(var(--color-accent-primary-rgb,67,97,238),0.06)] border border-[rgba(var(--color-accent-primary-rgb,67,97,238),0.15)] my-8">
            <h3 class="text-xl font-bold text-[var(--color-text-main)] mb-2">Need Urgent Assistance?</h3>
            <p class="text-[var(--color-text-muted)] mb-4">
              Contact our dispatch team right away or leave a callback request. Our specialist will assess your situation and arrive with full equipment.
            </p>
            <div class="flex flex-wrap gap-4 text-base font-bold text-[var(--color-accent-primary)]">
              <a href="tel:+18005550199" class="hover:underline">+1 (800) 555-0199</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
  
  <ConsultationForm />
  <Footer />
</Layout>
