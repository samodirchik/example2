---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ConsultationForm from '../../components/sections/ConsultationForm.astro';
import ParticleBackground from '../../components/ParticleBackground.astro';
---

<Layout title="Mosquito Control Services - Cucaracha" description="Outdoor mosquito misting and larvicide treatments for private estates, gardens, and recreation venues. Enjoy comfortable outdoor living.">
  <ParticleBackground />
  <Header />
  
  <main class="pt-32 pb-16 relative z-10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumbs -->
      <nav class="flex text-sm text-[var(--color-text-muted)] mb-8 font-medium">
        <ol class="flex items-center space-x-2">
          <li>
            <a href="/" class="hover:text-[var(--color-accent-primary)] transition-colors">Home</a>
          </li>
          <li><span class="mx-2">/</span></li>
          <li>
            <span class="hover:text-[var(--color-accent-primary)] transition-colors">Pest Control</span>
          </li>
          <li><span class="mx-2">/</span></li>
          <li class="text-[var(--color-text-main)]">
            Mosquitoes
          </li>
        </ol>
      </nav>

      <div class="glass-panel p-8 md:p-12 rounded-3xl shadow-xl">
        <h1 class="text-4xl md:text-5xl font-black mb-8 text-[var(--color-text-main)] tracking-tight leading-tight">
          Mosquito Control & Outdoor Misting
        </h1>
        
        <div class="prose prose-lg prose-headings:font-bold prose-headings:text-[var(--color-text-main)] prose-p:text-[var(--color-text-muted)] prose-img:rounded-2xl prose-img:shadow-lg max-w-none">
          <p class="text-xl font-medium text-[var(--color-text-main)] mb-8">
            Mosquitoes breed in stagnant ponds, drainage ditches, and dense shrubbery, severely disrupting outdoor relaxation and outdoor restaurant terraces.
          </p>

          <h2 class="text-2xl mt-10 mb-4">Risks and Threats</h2>
          <p class="mb-6">
            Mosquitoes are vectors for heartworm in domestic pets and transmit fever-causing pathogens, accompanied by burning itchy bites and skin allergies.
          </p>

          <div class="my-8">
<figure class="wp-block-image size-large"><img fetchpriority="high" decoding="async" width="1024" height="683" src="/images/wp-content/uploads/2024/03/nathan-cima-Ol_UGHN7cLU-unsplash-1-1024x683.jpg" alt="Mosquitoes" class="wp-image-361" style="aspect-ratio:16/9;object-fit:cover" title="Mosquitoes" srcset="/images/wp-content/uploads/2024/03/nathan-cima-Ol_UGHN7cLU-unsplash-1-1024x683.jpg 1024w, /images/wp-content/uploads/2024/03/nathan-cima-Ol_UGHN7cLU-unsplash-1-300x200.jpg 300w, /images/wp-content/uploads/2024/03/nathan-cima-Ol_UGHN7cLU-unsplash-1-768x512.jpg 768w, /images/wp-content/uploads/2024/03/nathan-cima-Ol_UGHN7cLU-unsplash-1-1536x1024.jpg 1536w, /images/wp-content/uploads/2024/03/nathan-cima-Ol_UGHN7cLU-unsplash-1-2048x1365.jpg 2048w" sizes="(max-width: 1024px) 100vw, 1024px" /></figure>

<figure class="wp-block-image size-large"><img decoding="async" width="1024" height="676" src="/images/wp-content/uploads/2024/03/Pest-control-service-worker-for-kids-vector-illustrations-set-24-1024x676.jpg" alt="Mosquitoes" class="wp-image-360" style="aspect-ratio:16/9;object-fit:cover" title="Mosquitoes" srcset="/images/wp-content/uploads/2024/03/Pest-control-service-worker-for-kids-vector-illustrations-set-24-1024x676.jpg 1024w, /images/wp-content/uploads/2024/03/Pest-control-service-worker-for-kids-vector-illustrations-set-24-300x198.jpg 300w, /images/wp-content/uploads/2024/03/Pest-control-service-worker-for-kids-vector-illustrations-set-24-768x507.jpg 768w, /images/wp-content/uploads/2024/03/Pest-control-service-worker-for-kids-vector-illustrations-set-24-1536x1014.jpg 1536w, /images/wp-content/uploads/2024/03/Pest-control-service-worker-for-kids-vector-illustrations-set-24-2048x1352.jpg 2048w" sizes="(max-width: 1024px) 100vw, 1024px" /></figure>
</div>

          <h2 class="text-2xl mt-10 mb-4">Professional Extermination Process</h2>
          <p class="mb-4">
            Our certified specialists deploy industry-leading methodologies to eradicate infestations quickly, completely, and safely:
          </p>
          <ul class="space-y-3 mb-8">
            <li><span>Site audit identifying standing water reservoirs, damp vegetation, and shaded resting zones;</span></li>
            <li><span>Application of eco-friendly biological larvicides to eliminate developing mosquito larvae in ponds;</span></li>
            <li><span>Motorized misting of perimeter hedges, foliage, lawns, and tree lines with knock-down adulticides;</span></li>
            <li><span>Creation of an invisible chemical barrier repelling incoming mosquito swarms for weeks;</span></li>
            <li><span>Season-long treatment plans and quality guarantees.</span></li>
          </ul>

          <h2 class="text-2xl mt-10 mb-4">Why Choose Cucaracha?</h2>
          <p class="mb-4">
            With over 9 years of field experience and 11,000+ satisfied clients, Cucaracha guarantees unparalleled service standards:
          </p>
          <ul class="space-y-3 mb-8">
            <li><span><strong>12-Month Quality Warranty</strong> — complete peace of mind with free follow-up treatments if needed;</span></li>
            <li><span><strong>EPA-Registered Formulations</strong> — maximum pest lethality with zero risk to humans and domestic pets;</span></li>
            <li><span><strong>Rapid 24/7 Response</strong> — expert technicians available around the clock across all major cities;</span></li>
            <li><span><strong>Transparent Pricing</strong> — starting from  with no hidden costs or unnecessary add-ons.</span></li>
          </ul>

          <div class="p-6 rounded-2xl bg-[rgba(var(--color-accent-primary-rgb,67,97,238),0.06)] border border-[rgba(var(--color-accent-primary-rgb,67,97,238),0.15)] my-8">
            <h3 class="text-xl font-bold text-[var(--color-text-main)] mb-2">Need Urgent Assistance?</h3>
            <p class="text-[var(--color-text-muted)] mb-4">
              Contact our dispatch team right away or leave a callback request. Our specialist will assess your situation and arrive with full equipment.
            </p>
            <div class="flex flex-wrap gap-4 text-base font-bold text-[var(--color-accent-primary)]">
              <a href="tel:+18005550199" class="hover:underline">+1 (800) 555-0199</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
  
  <ConsultationForm />
  <Footer />
</Layout>
