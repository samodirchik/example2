<script is:inline>
  function initShopTimer() {
    const labels = document.querySelectorAll('.current-day-label');
    labels.forEach(label => {
      const now = new Date();
      const options = { day: '2-digit', month: '2-digit', year: 'numeric' };
      const isUa = document.documentElement.lang === 'ua' || window.location.pathname.includes('-ua');
      label.textContent = now.toLocaleDateString(isUa ? 'uk-UA' : 'ru-RU', options);
    });

    const endTime = new Date();
    endTime.setHours(23, 59, 59, 999);

    const dEls = document.querySelectorAll('.timer-days');
    const hEls = document.querySelectorAll('.timer-hours');
    const mEls = document.querySelectorAll('.timer-minutes');
    const sEls = document.querySelectorAll('.timer-seconds');

    function update() {
      const now = new Date();
      const diff = endTime.getTime() - now.getTime();

      if (diff <= 0) return;

      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
      const minutes = Math.floor((diff / 1000 / 60) % 60);
      const seconds = Math.floor((diff / 1000) % 60);

      dEls.forEach(el => el.textContent = days.toString().padStart(2, '0'));
      hEls.forEach(el => el.textContent = hours.toString().padStart(2, '0'));
      mEls.forEach(el => el.textContent = minutes.toString().padStart(2, '0'));
      sEls.forEach(el => el.textContent = seconds.toString().padStart(2, '0'));
    }

    update();
    if(window.shopTimerInterval) clearInterval(window.shopTimerInterval);
    window.shopTimerInterval = setInterval(update, 1000);
  }

  document.addEventListener('astro:page-load', initShopTimer);
</script>
</Layout>