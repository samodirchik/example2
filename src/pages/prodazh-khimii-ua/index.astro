---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ParticleBackground from '../../components/ParticleBackground.astro';
import ConsultationForm from '../../components/sections/ConsultationForm.astro';

const lang = 'ua';
---

<Layout title="Продаж хімії" description="Купити засоби для дезінсекції та дератизації. Авторські концентровані препарати" lang={lang}>
  <ParticleBackground />
  <Header lang={lang} />
  <main class="pt-36 relative z-10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center mb-16">
        <!-- Text Content -->
        <div class="text-center lg:text-left animate-fade-in-up flex flex-col items-center lg:items-start">
          <div class="mb-4 inline-flex items-center justify-center px-4 py-2 rounded-full glass-panel text-sm font-semibold text-[var(--color-text-main)] shadow-sm self-center lg:self-start">
            <span class="w-2 h-2 rounded-full bg-[var(--color-accent-primary)] animate-pulse mr-2"></span>
            Увага, Акція!
          </div>
          
          <h1 class="text-4xl md:text-6xl font-bold mb-8 leading-tight tracking-tighter" style="font-family: var(--font-heading)">
            Засоби №1 від <br/>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-[var(--color-accent-primary)] to-[#00d2ff]">
              Комах та Гризунів
            </span>
          </h1>
          
          <ul class="text-base md:text-lg text-[var(--color-text-main)] font-bold mb-10 space-y-4 max-w-xl text-left inline-block">
            <li class="flex items-start">
              <svg class="w-6 h-6 text-[var(--color-accent-primary)] mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              Купити засоби для дезінсекції та дератизації - Гарантія - 12 місяців!
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-[var(--color-accent-primary)] mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              Авторські концентровані препарати
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-[var(--color-accent-primary)] mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              Без запаху, не залишає слідів і плям
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-[var(--color-accent-primary)] mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              Безпечно для людей і тварин
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-[var(--color-accent-primary)] mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              Самостійна обробка
            </li>
            <li class="flex items-start">
